<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Fothos.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <Image Source="dotnet_bot.png" HeightRequest="120" HorizontalOptions="Center" />

            <Label Text="Iniciar Sesión" FontSize="28" TextColor="White" HorizontalOptions="Center" FontAttributes="Bold" />

            <!-- Usuario -->
            <Border Stroke="#6C63FF" StrokeThickness="1" BackgroundColor="#1E1E1E">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Entry Placeholder="Usuario" PlaceholderColor="#888" TextColor="White" 
                       Text="{Binding Username}" Margin="10,0" />
            </Border>

            <!-- Contraseña -->
            <Border Stroke="#6C63FF" StrokeThickness="1" BackgroundColor="#1E1E1E">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Entry Placeholder="Contraseña" PlaceholderColor="#888" TextColor="White" 
                       IsPassword="True" Text="{Binding Password}" Margin="10,0" />
            </Border>

            <!-- Mensaje de Error -->
            <Label Text="{Binding ErrorMessage}" TextColor="#FF6B6B" 
                   HorizontalOptions="Center" />

            <!-- Botón de Login -->
            <Button Text="INGRESAR" BackgroundColor="#6C63FF" TextColor="White" 
                    FontAttributes="Bold" CornerRadius="10"
                    Command="{Binding LoginCommand}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#6C63FF" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>