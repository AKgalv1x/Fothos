<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Fothos.Models"
             x:Class="Fothos.Views.GaleriaPage"
             Title="Mi Galería"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto, *">

        <!-- Título de la galería -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20,20,20,10">
            <Label Grid.Column="0" Text="Mis Fotos" FontSize="28" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="➕" FontSize="20" BackgroundColor="#6C63FF" TextColor="White" 
            CornerRadius="25" WidthRequest="50" HeightRequest="50"
            Clicked="OnAgregarFotoClicked" />
        </Grid>

        <!-- Lista de fotos (CollectionView) -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Photos}" Margin="10" 
                SelectionMode="Single" SelectionChanged="OnFotoSeleccionada">

            <!-- EmptyView: Lo que se muestra cuando la lista está vacía (Requisito del profe) -->
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                    <Label Text="📸" FontSize="60" HorizontalOptions="Center" />
                    <Label Text="Aún no tienes fotos." FontSize="18" TextColor="#888" HorizontalOptions="Center" />
                    <Label Text="¡Toma tu primera foto!" FontSize="14" TextColor="#555" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <!-- Plantilla de cada tarjeta -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PhotoItem">
                    <Border Stroke="#333" StrokeThickness="1" BackgroundColor="#1E1E1E" 
                            Margin="5" Padding="10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                            <!-- Miniatura (Por ahora vacía, luego pondremos la ruta real) -->
                            <Image Grid.Column="0" Source="{Binding ImagePath}" 
                                   WidthRequest="80" HeightRequest="80" Aspect="AspectFill">
                                <Image.Clip>
                                    <RoundRectangleGeometry CornerRadius="8" Rect="0,0,80,80" />
                                </Image.Clip>
                            </Image>

                            <!-- Datos -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding Title}" TextColor="White" FontSize="16" FontAttributes="Bold" />
                                <Label Text="{Binding Category}" TextColor="#6C63FF" FontSize="12" FontAttributes="Bold"/>
                                <Label Text="{Binding FormattedDate}" TextColor="#888" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>